{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cumulative kilometres of bicycle lanes in Chile, by region",
  "title": {
    "text": "Cumulative kilometres of bicycle lanes in Chile, by region",
    "anchor": "start",
    "subtitle": "Source: Geoportal - IDE Chile and Ministerio de Bienes Nacionales",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "vconcat": [
    {
      "height": 500,
      "width": 700,
      "resolve": {"scale": {"color": "independent"}},
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/macarenaandradem-boop/macarenaandradem-boop.github.io/refs/heads/main/CICLOVnac_dic25_ISO.csv"
          },
          "params": [
            {
              "name": "regionSel",
              "select": {"type": "point", "fields": ["region"]},
              "bind": "legend"
            }
          ],
        "transform": [
          {"filter": "year(datum.YEAR_EJECUCION) >= 2000 && year(datum.YEAR_EJECUCION) <= 2025"},
          {"calculate": "year(datum.YEAR_EJECUCION)", "as": "anio"},
          {
            "aggregate": [{"op": "sum", "field": "KM", "as": "km_anio"}],
            "groupby": ["region", "anio"]
          },
          {
            "impute": "km_anio",
            "key": "anio",
            "keyvals": {"start": 2000, "stop": 2026},
            "groupby": ["region"],
            "value": 0
          },
          {
            "window": [{"op": "sum", "field": "km_anio", "as": "km_acum"}],
            "groupby": ["region"],
            "sort": [{"field": "anio"}],
            "frame": [null, 0]
          },
          {"calculate": "datetime(datum.anio, 0, 1)", "as": "fecha"}
        ],
          "mark": {"type": "line", "point": true, "strokeWidth": 2},
          "encoding": {
            "x": {
              "field": "fecha",
              "type": "temporal",
              "title": "Year",
              "axis": {"grid": false, "format": "%Y", "tickCount": "year", "labelAngle": 0}
            },
            "y": {
              "field": "km_acum",
              "type": "quantitative",
              "title": "Cumulative length of bicycle lanes (km)"
            },
            "color": {
              "field": "region",
              "type": "nominal",
              "title": "Region (click to select)",
              "scale": {"scheme": "tealblues"},
              "legend": {"symbolType": "stroke"}
            },
            "opacity": {
              "condition": {"param": "regionSel", "value": 1},
              "value": 0.12
            },
            "tooltip": [
              {"field": "region", "title": "Region"},
              {"field": "fecha", "type": "temporal", "format": "%Y", "title": "Year"},
              {"field": "km_acum", "type": "quantitative", "format": ",.1f", "title": "Cumulative km"}
            ]
          }
        },
        {
          "data": {
            "values": [
              {"fecha": "2021-01-01", "evento": "Change and/or re-election of governor"},
              {"fecha": "2024-01-01", "evento": "Change and/or re-election of governor"}
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#888888",
            "strokeDash": [4, 4],
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {"field": "fecha", "type": "temporal"},
            "tooltip": [
              {"field": "evento", "title": "Event"},
              {"field": "fecha", "type": "temporal", "format": "%Y", "title": "Year"}
            ]
          }
        }
      ]
    },
    {
      "height": 40,
      "width": 700,
      "data": {"values": [{"nota": "note"}]},
      "view": {"stroke": null},
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "color": "#444444",
        "text": [
          "Note: Dashed lines mark regional governor changes and/or re-elections.",
          "The first election of governors took place in 2021; previously, they were appointed by the President of the Republic."
        ]
      },
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 0}
      }
    }
  ]
}
