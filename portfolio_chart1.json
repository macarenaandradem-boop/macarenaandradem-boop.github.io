{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GDP per capita in Chile",
    "anchor": "start",
    "subtitle": "GDP per capita (current US$) - Chile | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },


  "height": 250,
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#ffffff",
  "view": {
    "fill": "#ffffff",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://raw.githubusercontent.com/macarenaandradem-boop/macarenaandradem-boop.github.io/refs/heads/main/CL-GDP_per_capita.csv"
  },
  "mark": {
    "type": "point",
    "color": "#0c7583",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year",
        "titleColor": "#122B39",
        "grid": false
      }
    },
    "y": {
      "field": "GDP-perCapita",
      "type": "quantitative",
      "axis": {
        "title": "GDP per capita (current US$)",
        "titleColor": "#122B39",
        "grid": false
      }
    }
  }
}
