{	
	"$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
	"data":
	{
		"url": "https://raw.githubusercontent.com/macarenaandradem-boop/macarenaandradem-boop.github.io/refs/heads/main/CICLOVnac_dic25_ISO.csv"
	}, 
	"title":
	{
		"text": "Bicycle Lanes in Chile opened in Chile (Kilometres)", 
		"anchor": "start", 
		"subtitle": "Source: Geoportal - IDE Chile and Ministerio de Bienes Nacionales"
	}, 
	"config": 
	{
		"view": 
		{
			"continuousWidth": 300, 
			"continuousHeight": 300
		}
	}, 


"layer":[
  {
    "mark": 
    {
      "type": "line", 
      "color": "#c8102e", 
      "strokeWidth": 1.5
    }, 
    "height": 280, 
    "width": 700,
    
    "transform": [
    {
      "filter": "year(datum.YEAR_EJECUCION) >= 2000"
    }
    ],
    "encoding": 
    {
      "x": {"axis": {"grid": false,  "tickCount":"year","format":"%Y", "labelAngle":0}, "field": "YEAR_EJECUCION", "title": "Year", "type": "temporal"}, 
      "y": {"aggregate": "sum", "field": "KM", "title": "Total length of opened bicycle lanes (in kilometers)", "type": "quantitative", "scale":{"domain":[0,1000]}}
    },
  }, 


  {
    "data": {
      "values": [
       {"year":"2000-01-01"},
       {"year":"2006-01-01"}, 
       {"year":"2010-01-01"}, 
       {"year":"2014-01-01"},
       {"year":"2018-01-01"},
      {"year":"2022-01-01"} 
      ]
      },

      "mark": {
      "type": "rule",
      "color": "gray",
      "strokeDash": [4, 4],
      "strokeWidth": 1
    },
    "encoding": {
      "x": {
        "field": "year",
        "type": "temporal"
      }
    }
  }
]

}

