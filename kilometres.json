{
	"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
	"title":
	{
		"text": "Bicycle Lanes opened in Chile (Kilometres)", 
		"anchor": "start", 
		"subtitle": "Source: Geoportal - IDE Chile and Ministerio de Bienes Nacionales"
	}, 
	"data":
	{
		"url": "https://raw.githubusercontent.com/macarenaandradem-boop/macarenaandradem-boop.github.io/refs/heads/main/CICLOVnac_dic25_ISO.csv"
	}, 
	"height": 280, 
  "width": 700,

"resolve": {"scale": {"x": "shared"}},
"layer":[
  {
	"transform": [
    {
      "filter": "year(datum.YEAR_EJECUCION) >= 2000&& year(datum.YEAR_EJECUCION)<=2025"
    }
    ],
    "mark": 
    {
      "type": "line", 
      "color": "#0072B2", 
      "strokeWidth": 1.5
    }, 

    "encoding": 
    {
      "x": {"axis": {"grid": false,  "tickCount":"year","format":"%Y", "labelAngle":0}, "field": "YEAR_EJECUCION", "title": "Year", "type": "temporal"}, 
      "y": {"aggregate": "sum", "field": "KM", "title": "Total length of opened bicycle lanes (in kilometers)", "type": "quantitative", "scale":{"domain":[0,1000]}}
    }
  }, 

  {
    "data": {
        "values": [
          {"year": "2000-01-01", "series": "Change of government"},
          {"year": "2006-01-01", "series": "Change of government"},
          {"year": "2010-01-01", "series": "Change of government"},
          {"year": "2014-01-01", "series": "Change of government"},
          {"year": "2018-01-01", "series": "Change of government"},
          {"year": "2022-01-01", "series": "Change of government"}
        ]
      },

      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Lenght of bicycle lanes inaugurated",
              "Change of government"
            ],
            "range": ["#0072B2", "#888888"]
          },
          "legend": {
            "title": "Indicator",
            "orient": "bottom"
          }
        }
      }
    }
  ]

  }
