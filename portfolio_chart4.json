{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Mexico. Labour participation rate",
    "anchor": "start",
    "subtitle": "Source: INEGI through ECO API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#3a6fa1",
    "subtitleColor": "#808080"
  },
  "height": "250",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  "view": {"fill": "#ffffff", "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/mex/part?vega",
    "format": {"type": "json"}
  },
  "mark": {"type": "line", "color": "#07736c", "strokeWidth": "2"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "Rate, %", "titleColor": "#122B39", "grid": false}
    }
  },
  "config": {}
}