{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "xx",
  "data": {
    "url": "https://api.worldbank.org/v2/country/kor;chl;br;chn/indicator/SP.DYN.TFRT.IN?format=json&per_page=1000&mrnev=10",
    "format": {"property": "[1]"}
  },
  "mark": "line",
  "encoding": {
    "x": {"field": "date", "type": "temporal"},
    "y": {"field": "value", "type": "quantitative"},
    "color": {
      "field": "country.value",
      "type": "nominal",
      "scale": {"scheme": "tealblues"},
      "legend": {"title": "Country"}
    }
  },
  "config": {}
}